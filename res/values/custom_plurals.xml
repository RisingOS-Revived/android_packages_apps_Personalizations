<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Custom emoji font -->
    <plurals name="emoji_apps_done">
        <item quantity="one">Replaced %1$d emoji font in app data. Apps that use downloadable emoji now fall back to the system emoji.</item>
        <item quantity="other">Replaced %1$d emoji fonts in app data. Apps that use downloadable emoji now fall back to the system emoji.</item>
    </plurals>

    <!-- App Lock -->
    <plurals name="app_lock_summary_count">
        <item quantity="one">1 app locked</item>
        <item quantity="other"><xliff:g id="count" example="3">%d</xliff:g> apps locked</item>
    </plurals>

    <plurals name="ts_added_installed_count">
        <item quantity="one">Added %d app to targets</item>
        <item quantity="other">Added %d apps to targets</item>
    </plurals>
</resources>
